# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# 训练产物
checkpoints/
*.pt
*.pth
*.ckpt
runs/
wandb/

# 数据（不入库）
data/

# Notebook
.ipynb_checkpoints/

# 探索性/临时测试脚本 (只留本地, 不入库)
test.py
test_*.py

# 二进制中间产物 (无法 diff; --save-detail 的 confusion.npy 不入库,
# 同信息的逐类 recall/precision/f1 已落在 results/*_perclass.csv 文本里)
*.npy
*.npz

# 批跑日志 (运行时产物, 体量随跑批次数增长, 不入库)
logs/

# 验证脚本的一次性快照 (verify_w5d2.py 每次运行自己重新生成, 不入库)
results/_*.json

# 一次性迁移/改动的备份 (migrate_csv.py 产物; 原文件在 git 历史里可查)
*.bak

# IDE 会话/项目数据目录 (系统要求保留该目录, 但不入库 —— 内容频繁变动、非实验产物)
.codebuddy/

# 开发期 dry 试跑组 (D1 端到端验证用, 按计划书"不入正式表"; 正式 10% 档在 W6 产出)
results/*-dry*
